# SMS gateway
SMS_SERVER_ADDRESS=https://your-provider.example
SMS_USERNAME=your_username
SMS_PASSWORD=your_password
# SMS_API_ENDPOINT=https://your-provider.example/path/to/messages

# Safety gate: keep false until configuration and campaign data are reviewed.
SMS_SEND_ENABLED=false

# Campaign input
SMS_CSV_FILE_PATH=data/contacts.csv
SMS_FIRST_NAME_COLUMN=first_name_per
SMS_PHONE_COLUMN=selected_phone

# Message template
SMS_MESSAGE_TEMPLATE=Hello {name}, this is a sample message.

# Request behavior
SMS_REQUEST_TIMEOUT=10
SMS_DELAY_BETWEEN_SMS=2

# Logging
SMS_LOG_LEVEL=INFO
SMS_LOG_FILE=logs/sms_campaign.log
