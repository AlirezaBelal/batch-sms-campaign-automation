# No credentials or network required for the bundled synthetic Dry Run.
SMS_DRY_RUN=true
SMS_SEND_ENABLED=false
SMS_CSV_FILE_PATH=examples/contacts.example.csv
SMS_FIRST_NAME_COLUMN=first_name_per
SMS_PHONE_COLUMN=selected_phone
SMS_MESSAGE_TEMPLATE=Hello {name}, this is a sample message.
SMS_CONSENT_SCOPE=demo

# Optional live setup: also requires --live and matching campaign confirmation.
# Never send the bundled sample or use purchased/scraped/unverified lists.
SMS_SERVER_ADDRESS=https://api.sms-gate.app
# SMS_API_ENDPOINT=https://your-trusted-gateway.example/3rdparty/v1/messages
SMS_USERNAME=
SMS_PASSWORD=
# Live mode requires an explicitly reviewed non-demo scope and exclusion CSV.
SMS_EXCLUSIONS_FILE=
SMS_MAX_RECIPIENTS=100
# Same operator-chosen currency for BOTH values. Unit cost is per SMS segment.
# Estimates are NOT authoritative provider billing. Live mode requires > 0.
SMS_ESTIMATED_UNIT_COST=0
SMS_MAX_ESTIMATED_COST=0
SMS_REQUEST_TIMEOUT=10
SMS_DELAY_BETWEEN_SMS=2
SMS_MANIFEST_DIR=campaign-state
